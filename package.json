{
  "name": "@isardtrail/itm",
  "version": "1.0.0",
  "description": "ITM · Isard Trail Meters — an open, deterministic trail-running fitness index with a pluggable, evidence-based modifier system.",
  "license": "MIT",
  "author": "Isard Trail (https://isardtrail.com)",
  "homepage": "https://github.com/isardmart/itm-index-trail-running#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isardmart/itm-index-trail-running.git"
  },
  "bugs": {
    "url": "https://github.com/isardmart/itm-index-trail-running/issues"
  },
  "keywords": [
    "trail-running",
    "ultra",
    "fitness",
    "training-load",
    "itm",
    "utmb",
    "strava"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/reference",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke-install.mjs",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test:coverage && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.7"
  }
}
